# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# Generated exports can contain their own package install. Never commit it.
**/node_modules/
outputs/**/*.inspect.ndjson
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Private local profile reviews and their separate browser session
/integrations/firstclassbot/profile_review_data/
/integrations/firstclassbot/browser_profile_review/
/integrations/firstclassbot/browser_profile_review_chrome/

# Local Atlas UI verification downloads and screenshots
/tmp/atlas-posters-ui/
/tmp/star-tracker-ui/
/tmp/star-leaderboard-ui/

# Private report screenshots, progress and PDFs
/integrations/firstclassbot/profile_report_data/
/integrations/firstclassbot/browser_profile_reports/
/tmp/profile-reports-ui/
/tmp/pdfs/
/output/pdf/
